{
  "name": "agflow",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "build:web": "bun run --cwd packages/web build",
    "test": "bun test",
    "hub": "bun packages/hub/src/main.ts",
    "smoke:hub": "bun scripts/smoke-hub.ts",
    "smoke:cli": "bun packages/cli/scripts/smoke.ts",
    "build:cli": "bun build --compile packages/cli/src/main.ts --outfile dist/agflow",
    "verify:real-clis": "bun packages/cli/scripts/verify-real-clis.ts",
    "demo": "bun scripts/demo-hub.ts",
    "check:ui": "bun scripts/check-ui.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
