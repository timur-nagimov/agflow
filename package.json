{
  "name": "agflow",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "build:web": "bun run --cwd packages/web build",
    "test": "bun test",
    "hub": "bun packages/hub/src/main.ts",
    "restore": "bun packages/hub/src/restore.ts",
    "smoke:hub": "bun scripts/smoke-hub.ts",
    "smoke:cli": "bun packages/cli/scripts/smoke.ts",
    "build:cli": "bun build --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv packages/cli/src/main.ts --outfile dist/agflow",
    "verify:real-clis": "bun packages/cli/scripts/verify-real-clis.ts",
    "demo": "bun scripts/demo-hub.ts",
    "check:ui": "bun scripts/check-ui.ts",
    "vendor:install": "bun packages/runner/scripts/vendor-install.ts",
    "verify:prep": "bun packages/runner/scripts/verify-prep.ts",
    "verify:service": "bun packages/runner/scripts/verify-service.ts",
    "record:claude": "bun packages/runner/scripts/record-claude-stream.ts",
    "smoke:claude": "AGFLOW_SMOKE=1 bun test packages/runner/test/claude-real",
    "check:claude-sandbox": "AGFLOW_SMOKE=1 AGFLOW_SANDBOX_CHECKS=1 bun test packages/runner/test/claude-sandbox",
    "gen:codex-protocol": "bun packages/runner/scripts/gen-codex-protocol.ts",
    "smoke:codex": "AGFLOW_SMOKE=1 bun test packages/runner/test/codex",
    "check:codex-sandbox": "AGFLOW_SMOKE=1 AGFLOW_SANDBOX_CHECKS=1 bun test packages/runner/test/codex/real/sandbox.test.ts",
    "e2e": "AGFLOW_E2E=1 caffeinate -i bun test --timeout 600000 packages/testkit/e2e",
    "live-run": "caffeinate -i bun scripts/live-run.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
