# Install as /etc/agflow/hub.env, root:root 0600. systemd syntax, not a shell script.
# Replace REPLACE_* values. Quote values containing spaces. No inline comments or export.
# Authentication mode: always github on a public host (never dev).
AGFLOW_AUTH=github
# OAuth app client ID and client secret from GitHub (not a PAT).
GITHUB_CLIENT_ID=REPLACE_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_CLIENT_SECRET
# Comma-separated GitHub logins; case-insensitive, checked on every session verification.
AGFLOW_ALLOWED_USERS=REPLACE_OWNER,REPLACE_COLLEAGUE
# Display name and repository URL used by the Macs' git credentials; the hub needs no git token.
AGFLOW_PROJECT_NAME=REPLACE_PROJECT_NAME
AGFLOW_PROJECT_REPO=https://github.com/REPLACE_ORG/REPLACE_REPO.git
# Public HTTPS origin, no trailing slash/path. Also controls OAuth callback, CSRF and Secure cookies.
AGFLOW_PUBLIC_URL=https://REPLACE_PUBLIC_HOST
# Bind only to Caddy's loopback upstream; these values match the supplied Caddyfile.
AGFLOW_HOST=127.0.0.1
AGFLOW_PORT=8787
# DB, WAL, SHM, PID/lock and restored/replaced databases must live on the writable state volume.
AGFLOW_DB=/var/lib/agflow/data/agflow.db
# Consistent hourly/daily/start snapshots and restore epoch file; also writable by agflow.
AGFLOW_BACKUP_DIR=/var/lib/agflow/backups
# Required to serve the UI from the current release (otherwise only the API is served).
AGFLOW_WEB_DIST=/opt/agflow/current/packages/web/dist
# Total worker limit across both Macs (runner capacity is configured separately; default 4).
AGFLOW_MAX_WORKERS=4
# Optional operator access for a script on this server (docs/deploy-hub.md "Operator access"): marks tasks merged,
# unblocks them and messages the lead as AGFLOW_OPERATOR_USER. Generate with: openssl rand -hex 32. Keep it only here.
# AGFLOW_OPERATOR_TOKEN=
# AGFLOW_OPERATOR_USER=
# Live-chat task lease and reminder interval, in minutes.
AGFLOW_LEASE_MINUTES=120
AGFLOW_REMINDER_MINUTES=30
# Guards on open tasks and task creation per hour.
AGFLOW_MAX_OPEN_TASKS=200
AGFLOW_MAX_TASKS_PER_HOUR=60
# Runner silence lease, in minutes (minimum 5).
AGFLOW_RUNNER_LEASE_MINUTES=15
# Scheduler tick, in seconds (minimum 5).
AGFLOW_TICK_SECONDS=15
# Stall deadline, in minutes (minimum 5).
AGFLOW_STALL_MINUTES=10
# Ordinary and long-running tool time caps, in minutes.
AGFLOW_TOOL_CAP_MINUTES=30
AGFLOW_LONG_TOOL_CAP_MINUTES=90
# Reconciliation window after restart/downtime, in seconds (minimum 30).
AGFLOW_RECOVERY_SECONDS=120
# Human approval deadline, in minutes (minimum 5).
AGFLOW_APPROVAL_MINUTES=15
# Lead review and live-lead grace windows, in minutes.
AGFLOW_LEAD_REVIEW_MINUTES=45
AGFLOW_LIVE_LEAD_GRACE_MINUTES=120
# Quota wait and unknown-quota windows, in minutes.
AGFLOW_QUOTA_WAIT_MINUTES=45
AGFLOW_QUOTA_UNKNOWN_MINUTES=30
# Active attempt budget and submission timeout, in minutes (submission minimum 5).
AGFLOW_ACTIVE_BUDGET_MINUTES=240
AGFLOW_SUBMIT_TIMEOUT_MINUTES=15
# Retry ladder attempt count, lead rotation wake-ups and plan churn guard.
AGFLOW_MAX_ATTEMPTS=3
AGFLOW_LEAD_ROTATE_WAKEUPS=20
AGFLOW_MAX_PLAN_CHANGES_PER_HOUR=60
# Git namespace for runner work and main project branch.
AGFLOW_WIP_REF_PREFIX=refs/agflow/
AGFLOW_MAIN_BRANCH=main
# AGFLOW_TEST and AGFLOW_TEST_CONFIG are test-only and must remain unset in production.
