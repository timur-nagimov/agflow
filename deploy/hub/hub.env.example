# Install as /etc/agflow/hub.env, root:root 0600. systemd syntax, not a shell script.
# Replace REPLACE_* values. Quote values containing spaces. No inline comments or export.
# Authentication mode: always github on a public host (never dev).
AGFLOW_AUTH=github
# OAuth app client ID and client secret from GitHub (not a PAT).
GITHUB_CLIENT_ID=REPLACE_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_CLIENT_SECRET
# Comma-separated GitHub logins; case-insensitive, checked on every session verification.
AGFLOW_ALLOWED_USERS=REPLACE_OWNER,REPLACE_COLLEAGUE
# Display name and repository URL used by the Macs' git credentials; the hub needs no git token.
AGFLOW_PROJECT_NAME=REPLACE_PROJECT_NAME
AGFLOW_PROJECT_REPO=https://github.com/REPLACE_ORG/REPLACE_REPO.git
# Public HTTPS origin, no trailing slash/path. Also controls OAuth callback, CSRF and Secure cookies.
AGFLOW_PUBLIC_URL=https://REPLACE_PUBLIC_HOST
# Bind only to Caddy's loopback upstream; these values match the supplied Caddyfile.
AGFLOW_HOST=127.0.0.1
AGFLOW_PORT=8787
# DB, WAL, SHM, PID/lock and restored/replaced databases must live on the writable state volume.
AGFLOW_DB=/var/lib/agflow/data/agflow.db
# Consistent hourly/daily/start snapshots and restore epoch file; also writable by agflow.
AGFLOW_BACKUP_DIR=/var/lib/agflow/backups
# Required to serve the UI from the current release (otherwise only the API is served).
AGFLOW_WEB_DIST=/opt/agflow/current/packages/web/dist
# Total worker limit across both Macs (runner capacity is configured separately; default 4).
AGFLOW_MAX_WORKERS=4
# Optional operator token (docs/deploy-hub.md "Operator access"; openssl rand -hex 32): sets the goal and the deadline,
# resets the project, marks tasks merged, unblocks them and messages the lead as AGFLOW_OPERATOR_USER. agflow start on
# the owner's Mac uses the same token, saved there with agflow operator-token set (Keychain item agflow-operator).
# AGFLOW_OPERATOR_TOKEN=
# AGFLOW_OPERATOR_USER=
# 1: a task's dependencies are done only when merged (not when accepted). Use it when something merges accepted
# branches into main (an operator script), so dependent work starts from a main that holds its dependencies.
# AGFLOW_DEPENDENCIES_NEED_MERGE=1
# 1: the hub downloads one public URL at a time for Claude runner agents: the lead, and the tasks the lead granted.
# Risk: an agent that reads hostile text can leak what its sandbox lets it read through the addresses it asks for, and
# the requests come from this server's address (docs/deploy-hub.md "Unattended operation").
# AGFLOW_AGENT_FETCH=1
# 1: the agent holding the lead seat may answer other agents' approval requests; on a managed device it may only decline.
# Risk: an approved command runs outside the sandbox with the runner owner's network and file access, on an agent's
# judgement instead of the owner's.
# AGFLOW_LEAD_APPROVALS=1
# 1: the hub approves every approval request the moment it arrives, unless the runner's device policy reserves
# approvals to its owner. Risk: every command an agent asks to run outside the sandbox runs there, with the runner
# owner's network and file access, and no one reads it first.
# AGFLOW_AUTO_APPROVALS=1
# 1: agflow merges accepted work into main itself: a runner merges one task at a time and pushes main with its owner's
# git credentials, so main must accept direct pushes (no branch protection). A conflict sends the task back.
# AGFLOW_AUTO_MERGE=1
# 1: the hub accepts a runner submission whose check (.agflow/config.json "check") passed, without the lead. A demo
# check, and a branch that changes the check's own files, still go to the lead; a branch that changes package.json
# scripts, test configuration or the tests does not. Risk: the check is the only review.
# AGFLOW_AUTO_ACCEPT=1
# After every this many tasks merged (or accepted, without auto merge and while nothing marks tasks merged) the hub
# creates a demo-check task that runs the product from main, records what works in docs/STATUS.md and lists each
# defect on a DEFECT: line for the lead. 0 turns it off; the default is 5.
# AGFLOW_DEMO_CHECK_EVERY=5
# Live-chat task lease and reminder interval, in minutes.
AGFLOW_LEASE_MINUTES=120
AGFLOW_REMINDER_MINUTES=30
# Guards on open tasks and task creation per hour.
AGFLOW_MAX_OPEN_TASKS=200
AGFLOW_MAX_TASKS_PER_HOUR=60
# Runner silence lease, in minutes (minimum 5).
AGFLOW_RUNNER_LEASE_MINUTES=15
# Scheduler tick, in seconds (minimum 5).
AGFLOW_TICK_SECONDS=15
# Stall deadline, in minutes (minimum 5).
AGFLOW_STALL_MINUTES=10
# Ordinary and long-running tool time caps, in minutes.
AGFLOW_TOOL_CAP_MINUTES=30
AGFLOW_LONG_TOOL_CAP_MINUTES=90
# Reconciliation window after restart/downtime, in seconds (minimum 30).
AGFLOW_RECOVERY_SECONDS=120
# Human approval deadline, in minutes (minimum 5).
AGFLOW_APPROVAL_MINUTES=15
# The periodic review: at most this often, the lead hears of work submitted to it for longer than this and of work in
# an attempt for more than 30 minutes. Then the live-lead grace window. Both in minutes.
AGFLOW_LEAD_REVIEW_MINUTES=45
AGFLOW_LIVE_LEAD_GRACE_MINUTES=120
# The idle nudge: once the dispatchable ready tasks are fewer than the worker slots, busy or free, for this many
# seconds, the runner lead is told to plan more, then not again for the minutes below. 0 minutes turns it off.
AGFLOW_IDLE_NUDGE_SECONDS=60
AGFLOW_IDLE_NUDGE_MINUTES=5
# Quota wait and unknown-quota windows, in minutes.
AGFLOW_QUOTA_WAIT_MINUTES=45
AGFLOW_QUOTA_UNKNOWN_MINUTES=30
# Active attempt budget and submission timeout, in minutes (submission minimum 5).
AGFLOW_ACTIVE_BUDGET_MINUTES=240
AGFLOW_SUBMIT_TIMEOUT_MINUTES=15
# Retry ladder attempt count, lead rotation wake-ups and plan churn guard.
AGFLOW_MAX_ATTEMPTS=3
AGFLOW_LEAD_ROTATE_WAKEUPS=20
AGFLOW_MAX_PLAN_CHANGES_PER_HOUR=60
# Git namespace for runner work and main project branch.
AGFLOW_WIP_REF_PREFIX=refs/agflow/
AGFLOW_MAIN_BRANCH=main
# Hackathon settings (docs/deploy-hub.md "Hackathon settings"): two Macs and a VM working unattended until the deadline.
# A key may be set only once (activate.sh refuses duplicates): for each line you uncomment here, delete the key's line
# above. Auto merge needs a main that accepts direct pushes.
# AGFLOW_MAX_WORKERS=20
# AGFLOW_QUOTA_WAIT_MINUTES=5
# AGFLOW_LEAD_ROTATE_WAKEUPS=100
# AGFLOW_MAX_PLAN_CHANGES_PER_HOUR=600
# AGFLOW_MAX_TASKS_PER_HOUR=300
# AGFLOW_LEAD_REVIEW_MINUTES=10
# AGFLOW_AUTO_ACCEPT=1
# AGFLOW_AUTO_MERGE=1
# AGFLOW_IDLE_NUDGE_MINUTES=5
# AGFLOW_DEMO_CHECK_EVERY=5
# AGFLOW_AGENT_FETCH=1
# AGFLOW_LEAD_APPROVALS=1
# AGFLOW_AUTO_APPROVALS=1
# AGFLOW_TEST and AGFLOW_TEST_CONFIG are test-only and must remain unset in production.
